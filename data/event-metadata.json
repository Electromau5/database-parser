  "categories": [
    {
      "name": "Identity",
      "covers": "What the event is called and how it is told apart from every other event.",
      "parserUse": "Title, slug - dedupe and matching."
    },
    {
      "name": "Date & Time",
      "covers": "When it runs.",
      "parserUse": "Window gate (today to today+6, ET); clash detection."
    },
    {
      "name": "Location",
      "covers": "Where it runs and whether it is really in-person in NYC.",
      "parserUse": "NYC gate; in-person gate."
    },
    {
      "name": "Audience & Decision Makers",
      "covers": "Who is in the room - page words kept apart from inferred titles.",
      "parserUse": "Audience gate - the biggest lead-quality driver."
    },
    {
      "name": "Market / Track Fit",
      "covers": "Which of ADL's two client tracks it fits, and whether it passes the hard gates.",
      "parserUse": "Track routing; gate pass/fail before scoring."
    },
    {
      "name": "Topics & Themes",
      "covers": "What it is about.",
      "parserUse": "Search page text against the pipeline theme lists."
    },
    {
      "name": "Pain Points & Buying Signals",
      "covers": "What problem the room is talking about - page pain kept apart from ADL-inferred pain.",
      "parserUse": "Pain scoring, with an audit trail."
    },
    {
      "name": "Event Format",
      "covers": "How the room works - dinner, breakfast, mixer, expo.",
      "parserUse": "Format quality weighting."
    },
    {
      "name": "Registration & Access",
      "covers": "How you get in, and what cannot be read without acting.",
      "parserUse": "Apply-early actions; honest 'unknown' fields."
    },
    {
      "name": "Cost",
      "covers": "What it costs.",
      "parserUse": "Cost field; free vs paid filter."
    },
    {
      "name": "ADL Scoring & Strategic Fit",
      "covers": "ADL's own score, rank, goals served, and calendar routing.",
      "parserUse": "Ranking output - always read score + rank together."
    },
    {
      "name": "Speakers & Sponsors",
      "covers": "Who is speaking and who is backing the event.",
      "parserUse": ""
    }
